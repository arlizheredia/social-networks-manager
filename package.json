{
  "name": "social-networks-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Social Networks Manager: publica en grupos de Facebook y analiza comentarios de Facebook, Instagram y TikTok desde una sola app, con un solo modelo de IA local.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build:extension": "python3 tools/build-extension.py"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "idb-keyval": "6.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.0.0",
    "@types/chrome": "0.0.287",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "tailwindcss": "4.0.0",
    "typescript": "5.6.3",
    "vite": "6.0.3",
    "vitest": "2.1.8"
  },
  "overrides": {
    "@tailwindcss/node": "4.0.0",
    "@tailwindcss/oxide": "4.0.0"
  }
}
