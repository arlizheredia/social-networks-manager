{
  "manifest_version": 3,
  "name": "Social Networks Manager · Extensión",
  "short_name": "SNM",
  "version": "2.3.5",
  "description": "Publica en tus grupos de Facebook y extrae los comentarios de Facebook, Instagram y TikTok para Social Networks Manager, con tu propia sesión.",
  "minimum_chrome_version": "120",
  "permissions": [
    "cookies",
    "notifications",
    "power",
    "scripting",
    "storage",
    "tabs",
    "userScripts"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://arlizheredia.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arlizheredia.github.io/social-networks-manager/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge-publisher.js",
        "bridge-extractor.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "fb.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Social Networks Manager · volver a la app",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}